# =====================================================
# APPLICATION
# =====================================================

SECRET_KEY=change-me
DATABASE_NAME=database.db

APP_NAME=Survitec Task Performance Management System
APP_VERSION=1.0.0

# Used to build clickable task links inside emails.
# No trailing slash. Set to the deployed URL in production.
APP_BASE_URL=http://127.0.0.1:5000

# =====================================================
# SMTP / EMAIL
# =====================================================
# Encryption method: STARTTLS
#   port 587 -> MAIL_USE_TLS=True  and MAIL_USE_SSL=False
#   port 465 -> MAIL_USE_SSL=True  and MAIL_USE_TLS=False
# Mixing them (587 with SSL) fails with SSL WRONG_VERSION_NUMBER.

MAIL_SERVER=smtp.hmailplus.com
MAIL_PORT=587

MAIL_USE_TLS=True
MAIL_USE_SSL=False

MAIL_USERNAME=info@survitec.co.ke
MAIL_PASSWORD=your-smtp-password
MAIL_DEFAULT_SENDER=info@survitec.co.ke

MAIL_TIMEOUT=15

# Set True to log emails instead of sending them (local dev)
MAIL_SUPPRESS_SEND=False

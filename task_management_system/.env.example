SECRET_KEY=change-me
JWT_SECRET_KEY=change-me

DATABASE_URL=postgresql+psycopg2://survitec:change-me@127.0.0.1:5432/survitec

JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRES_DAYS=30

CORS_ORIGINS=http://localhost:4173,http://127.0.0.1:4173,http://localhost:4174,http://127.0.0.1:4174,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# The origin emailed links point at — password resets, leave notifications.
# Defaults to the first CORS origin when unset, which is fine locally but
# should be explicit anywhere real.
FRONTEND_URL=http://localhost:4173

APP_NAME=Survitec Task Performance Management System
APP_VERSION=1.0.0

FLASK_DEBUG=False

# Two transports, and the code prefers whichever is configured, Resend
# first. Set neither and email is disabled: each message is written to the
# server log instead, which is how a reset link is read in development.
#
# RESEND_API_KEY sends over HTTPS. Required anywhere outbound SMTP is
# blocked — including Render's free tier, where a connect to port 587 times
# out at the network level. MAIL_DEFAULT_SENDER is the From address and must
# be at a domain verified in the Resend account.
RESEND_API_KEY=

# SMTP. Works locally. Port 587 is STARTTLS, so USE_TLS True / USE_SSL False;
# swapping that pair fails the handshake rather than the login, which reads
# like a credential problem when it isn't.
MAIL_SERVER=
MAIL_PORT=465
MAIL_USE_SSL=True
MAIL_USE_TLS=False
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Bootstrap accounts. Created on first boot; changing an address here moves
# the existing account to it on the next boot (passwords are never rewritten
# once the account exists — reset those from inside the app).
SEED_SUPER_ADMIN_EMAIL=r.muthoni@survitec.co.ke
SEED_SUPER_ADMIN_PASSWORD=change-me
SEED_MANAGER_EMAIL=m.mwangangi@dahawicredit.co.ke
SEED_MANAGER_PASSWORD=change-me
SEED_HR_EMAIL=survitecequipmentsltd@gmail.com
SEED_HR_PASSWORD=change-me
